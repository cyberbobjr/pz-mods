{
  "name": "pz-mods",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/adapters/server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/adapters/server.ts",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:encoding && npm run lint && npm run typecheck && npm test && npm run build",
    "dev:backend": "tsx watch src/adapters/server.ts",
    "dev:frontend": "vite",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "fastify": "^5.0.0",
    "playwright-core": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0"
  },
  "description": "Local Project Zomboid mod manager with save diagnostics and load-order editing",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberbobjr/pz-mods.git"
  }
}
